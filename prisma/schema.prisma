generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  googleId      String?   @unique
  passwordHash    String?
  role            Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  configs       Config[]

  accounts Account[]
  sessions Session[]
}

model Config {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  publicKey           String   @unique
  privateKeyEncrypted String?
  allowedAddress      String
  mikrotikPeerId      String?
  importedFromMikrotik Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MikrotikSettings {
  id                String   @id @default("default")
  host              String   @default("")
  port              Int      @default(443)
  username          String   @default("")
  passwordEncrypted String   @default("")
  useHttps          Boolean  @default(true)
  tlsVerify         Boolean  @default(false)
  wgInterface       String   @default("")
  updatedAt         DateTime @updatedAt
}
