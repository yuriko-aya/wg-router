# Application
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Standalone server bind address (systemd + nginx: use 127.0.0.1)
HOSTNAME=127.0.0.1
PORT=3000

# Canonical public URL (no trailing slash).
# Dev:  http://localhost:3000
# Prod behind nginx: https://wg.example.com  (must be https, not http)
AUTH_URL=http://localhost:3000

# Trust X-Forwarded-* from nginx (recommended in production)
AUTH_TRUST_HOST=true

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostgreSQL (local on Linux host)
DATABASE_URL=postgresql://wgrouter:wgrouter@localhost:5432/wgrouter

# Encrypt stored WireGuard private keys (32-byte hex or base64)
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Comma-separated emails granted admin role on login
ADMIN_EMAILS=admin@example.com

# WireGuard server settings (included in client configs)
WG_SERVER_PUBLIC_KEY=your-server-public-key-base64
WG_SERVER_ENDPOINT=vpn.example.com:51820
# Client tunnel gateway(s) for DNS — IPv4 and/or IPv6, comma-separated
# Dual-stack example: 10.8.0.1/32,fd00:8::1/128
WG_SERVER_ADDRESS=10.8.0.1/32

# Assignable client IPs: IPv4/IPv6 CIDR and/or comma-separated list
# IPv4 CIDR: 10.8.0.0/24 (skips .0 and .1)
# IPv6 CIDR: fd00:8::/64 (assigns ::2, ::3, …)
# Dual-stack example: 10.8.0.0/24,fd00:8::/64
# Explicit list: 10.8.0.2,fd00:8::2,fd00:8::3
WG_CLIENT_IP_POOL=10.8.0.0/24

# Max configs per regular user
MAX_CONFIGS_PER_USER=3
