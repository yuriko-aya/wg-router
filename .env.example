# Application
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Bind address for systemd/nginx (127.0.0.1). Omit for Docker — entrypoint uses 0.0.0.0.
# HOSTNAME=127.0.0.1
PORT=3000

# Canonical public URL (no trailing slash).
# Dev:  http://localhost:3000
# Prod behind nginx: https://wg.example.com  (must be https, not http)
AUTH_URL=http://localhost:3000

# Trust X-Forwarded-* from nginx (recommended in production)
AUTH_TRUST_HOST=true

# Google OAuth2 (optional — leave blank for email/password only)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (runtime env — no Docker rebuild needed)
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database (optional — defaults to SQLite file:../data/wg-router.db)
# PostgreSQL example:
# DATABASE_URL=postgresql://wgrouter:wgrouter@localhost:5432/wgrouter
# SQLite example (good for containers / MikroTik CHR sidecar):
# DATABASE_URL=file:../data/wg-router.db

# Encrypt stored WireGuard private keys (32-byte hex or base64)
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Comma-separated emails granted admin role on login
ADMIN_EMAILS=admin@example.com

# WireGuard server settings (optional bootstrap — configure in Admin → MikroTik)
# WG_SERVER_PUBLIC_KEY=your-server-public-key-base64
# WG_SERVER_ENDPOINT=vpn.example.com:51820
# WG_SERVER_ADDRESS=10.8.0.1/32
# WG_CLIENT_IP_POOL=10.8.0.0/24

# Max configs per regular user
MAX_CONFIGS_PER_USER=3
